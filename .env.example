# Single source of truth for env-style secrets. Copy to .env (repo root) and fill in.
# PARSED by code (Python / Ansible), NEVER `source`d — values can contain shell-hostile
# characters (% ! > { } # & ; $ ...). SSH keys stay as files (see README).

# Host / AAP FQDN  (= <dnsLabel>.<region>.cloudapp.azure.com)
FQDN=aap-poc.<region>.cloudapp.azure.com

# ServiceNow PDI
SN_INSTANCE=your-instance.service-now.com
SN_USER=admin                    # admin account (bootstrap/servicenow/setup.py)
SN_PASS=change-me
SN_EDA_USERNAME=eda.integration  # service account (controller/EDA); set its password in the UI
SN_EDA_PASSWORD=change-me

# Red Hat registry service account (image pulls)
REGISTRY_USERNAME=1234567|your-service-account
REGISTRY_PASSWORD=change-me

# AAP admin (gateway/controller/hub/eda) — user fixed to 'admin' by the installer
AAP_ADMIN_USER=admin
AAP_ADMIN_PASSWORD=change-me

# Git project (controller/EDA pull playbooks/rulebooks from here)
GIT_REPO_URL=https://github.com/your-org/your-repo.git

# PUSH pattern (Change Request -> Event Stream): shared token ServiceNow sends in the
# Authorization header to the EDA event stream. Generate one: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
SN_EVENTSTREAM_TOKEN=change-me
