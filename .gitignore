# Secrets / keys — NEVER commit
*.pem
*.key
id_rsa*
id_ed25519*
*-poc
*-poc.pub
.env
.env.*
!.env.example
*.secret

# AAP install (Red Hat binaries + rendered inventory with secrets)
bootstrap/6A_aap/*.tar.gz
bootstrap/6A_aap/*.tar
bootstrap/6A_aap/inventory

# Infra params with environment-specific values (copy from the *.example.json templates)
bootstrap/1_infra/main.parameters.rhel.json
bootstrap/1_infra/main.parameters.ubuntu.json

# Target key material (generated; the public half is copied into the simulator build context)
bootstrap/2_fleet/keys/

# Python
__pycache__/
*.pyc

# OS
.DS_Store

# Fleet SSH public key (copy of the target key)
simulator/base/authorized_keys
